// This is the Prisma schema for the SeniorCare MVP.
// Database: SQLite (easy local setup). Swap to PostgreSQL for production:
//   provider = "postgresql"
//   url      = env("DATABASE_URL")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts       EmergencyContact[]
  passwordResets PasswordReset[]
  devices        Device[]
}

model EmergencyContact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Used for the password reset flow (email not wired yet — see README).
model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Um par de módulos ESP32. O serviço externo que processa o sinal Wi-Fi (CSI)
// autentica nesta API com a apiKeyHash — ver lib/device-auth.ts.
model Device {
  id            String    @id @default(cuid())
  name          String    @default("Dispositivo SeniorCare")
  apiKeyHash    String
  connected     Boolean   @default(false)
  lastSeenAt    DateTime?
  batteryLevel  Int?
  // Telemetria do último heartbeat enviado pela ponte (ver /api/ingest/heartbeat).
  detectorState String?
  activityLevel Float?
  rssi          Int?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        Event[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Evento já processado (ex.: queda detectada) recebido via HTTP do serviço
// que analisa o sinal Wi-Fi entre os dois ESP32 — ver app/api/ingest/events.
model Event {
  id         String    @id @default(cuid())
  type       String // "fall_detected" | "normal" | "low_battery" | "device_offline"
  severity   String // "high" | "medium" | "low"
  message    String
  confidence Float?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  // JSON com métricas do detector (pico, tempo de imobilidade, ...). Opcional.
  details    String?
  occurredAt DateTime  @default(now())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}
